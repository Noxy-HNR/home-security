# Copy to .env (scripts/setup.sh does this and fills in the generated secrets).
# Values are read by docker compose AND by the dashboard container, so keep them unquoted
# and free of spaces.

TZ=America/Chicago

# --- Dashboard -------------------------------------------------------------------------------
DASHBOARD_PORT=8080
# Bind address for the dashboard port. 0.0.0.0 = whole LAN; 127.0.0.1 if a reverse proxy
# on this box fronts it (Phase 6).
DASHBOARD_BIND=0.0.0.0
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=
SESSION_HOURS=12
# Set true once the dashboard is served over HTTPS (Phase 6)
COOKIE_SECURE=false
# Optional comma-separated bearer tokens for scripts: Authorization: Bearer <token>
API_TOKENS=

# --- Home Assistant (Total Connect) ------------------------------------------------------------
# Long-lived access token: HA profile page > Security > Long-lived access tokens (Phase 1)
HA_TOKEN=

# --- MQTT (Frigate <-> dashboard) --------------------------------------------------------------
MQTT_USER=security
MQTT_PASSWORD=

# --- Cameras -------------------------------------------------------------------------------------
NVR_HOST=192.168.1.64
NVR_RTSP_USER=admin
# URL-encode special characters (@ -> %40, # -> %23, : -> %3A)
NVR_RTSP_PASSWORD=
# Where recordings go. Point this at the big disk.
FRIGATE_MEDIA_DIR=./data/frigate/media
FRIGATE_SHM_SIZE=256mb
# Frigate's own UI (zones/masks). Also linked from the dashboard:
FRIGATE_PUBLIC_URL=https://192.168.1.10:8971

# Live grid refresh (Frigate's detect stream with boxes drawn)
LIVE_FPS=2
LIVE_HEIGHT=360

# --- Alerts ----------------------------------------------------------------------------------------
ALERT_LABELS=person
# Empty = every camera / anywhere in frame. Zone names are the ones you draw in Frigate.
ALERT_CAMERAS=
ALERT_ZONES=
ALERT_ONLY_WHEN_ARMED=false
ALERT_COOLDOWN_SECONDS=60
# Push to phones via ntfy (https://ntfy.sh or self-hosted). Use a long random topic name.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
NOTIFY_ARM_CHANGES=false
# Base URL for notification click-through, e.g. http://192.168.1.10:8080
PUBLIC_URL=

# --- Retention -------------------------------------------------------------------------------------
ARCHIVE_SNAPSHOTS=true
SNAPSHOT_RETENTION_DAYS=90
# 0 keeps the event log forever (rows are tiny)
EVENT_RETENTION_DAYS=0

# --- Database ------------------------------------------------------------------------------------
# Empty = SQLite in data/dashboard. For Postgres: docker compose --profile postgres up -d
# DATABASE_URL=postgresql+asyncpg://security:<POSTGRES_PASSWORD>@postgres:5432/security
DATABASE_URL=
POSTGRES_PASSWORD=

# Try the whole UI with simulated cameras and alarm (no hardware needed)
DEMO_MODE=false
