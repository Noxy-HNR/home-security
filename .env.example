# Copy to .env and fill in (scripts/setup.ps1 on Windows or scripts/setup.sh on Linux/macOS
# do the copy and generate the passwords). Read by docker compose and by the containers:
# keep values unquoted and without spaces.

TZ=America/Chicago

# --- Dashboard -------------------------------------------------------------------------------
DASHBOARD_PORT=8080
# 0.0.0.0 = reachable from the whole LAN; 127.0.0.1 = this computer only (or a reverse proxy)
DASHBOARD_BIND=0.0.0.0
DASHBOARD_PASSWORD=
# Leave empty to have one generated and kept in the dashboard's volume.
SESSION_SECRET=
SESSION_HOURS=12
# Set true once the dashboard is served over HTTPS (Phase 6)
COOKIE_SECURE=false
# Optional comma-separated bearer tokens for scripts: Authorization: Bearer <token>
API_TOKENS=

# --- Home Assistant (Total Connect) ------------------------------------------------------------
# Long-lived access token from HA: your profile > Security > Long-lived access tokens (Phase 1)
HA_TOKEN=
# Home Assistant's own UI, needed once to set up Total Connect
HA_PORT=8123

# --- MQTT (Frigate <-> dashboard, internal only) -------------------------------------------------
MQTT_USER=security
MQTT_PASSWORD=

# --- NVR (Foscam FN9108HE) -------------------------------------------------------------------------
NVR_HOST=192.168.1.64
NVR_RTSP_USER=admin
# URL-encode special characters (@ -> %40, # -> %23, : -> %3A, / -> %2F)
NVR_RTSP_PASSWORD=

# Stream URLs and cameras. Don't guess these: run the probe and paste what it prints.
#   docker compose run --rm --no-deps dashboard python -m app.probe
# Templates use {user} {password} {host} {ch} (1) {ch2} (01) {chz} (00).
NVR_MAIN_URL=
NVR_SUB_URL=
# name:channel for NVR channels, name@ip for a camera reached directly; optional :WxH per camera
# e.g. CAMERAS=front_door:1,driveway:2,backyard:3,porch@192.168.1.21
CAMERAS=
# Direct cameras default to Foscam's documented paths (port 88, /videoMain and /videoSub)
CAMERA_MAIN_URL=
CAMERA_SUB_URL=
# Size of the sub (detect) streams; the probe prints it
DETECT_SIZE=640x360
DETECT_FPS=5
# auto = OpenVINO on Intel/AMD, the CPU detector on Apple Silicon/ARM
DETECTOR=auto

# --- Frigate ----------------------------------------------------------------------------------------
# Recordings: a Docker volume by default. On Linux, a big disk works too (e.g. /mnt/cctv).
FRIGATE_MEDIA=frigate-media
FRIGATE_SHM_SIZE=256mb
FRIGATE_PORT=8971
# Frigate's own UI (zones/masks), linked from the dashboard: https://<this computer's IP>:8971
FRIGATE_PUBLIC_URL=

# Live grid refresh (Frigate's detect stream with boxes drawn)
LIVE_FPS=2
LIVE_HEIGHT=360

# --- Alerts ----------------------------------------------------------------------------------------
ALERT_LABELS=person
# Empty = every camera / anywhere in frame. Zone names are the ones you draw in Frigate.
ALERT_CAMERAS=
ALERT_ZONES=
ALERT_ONLY_WHEN_ARMED=false
ALERT_COOLDOWN_SECONDS=60
# Push to phones via ntfy (https://ntfy.sh or self-hosted). Use a long random topic name.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
NOTIFY_ARM_CHANGES=false
# Base URL for notification click-through, e.g. http://192.168.1.10:8080
PUBLIC_URL=

# --- Retention -------------------------------------------------------------------------------------
ARCHIVE_SNAPSHOTS=true
SNAPSHOT_RETENTION_DAYS=90
# 0 keeps the event log forever (rows are tiny)
EVENT_RETENTION_DAYS=0

# --- Database ------------------------------------------------------------------------------------
# Empty = SQLite in the dashboard's volume. For Postgres: docker compose --profile postgres up -d
# DATABASE_URL=postgresql+asyncpg://security:<POSTGRES_PASSWORD>@postgres:5432/security
DATABASE_URL=
POSTGRES_PASSWORD=

# Try the whole UI with simulated cameras and alarm (no hardware needed)
DEMO_MODE=false
